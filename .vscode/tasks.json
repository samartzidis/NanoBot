{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/NanoBot.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-linux-arm64",
            "dependsOn": ["build-ui"],
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/NanoBot/NanoBot.csproj",
                "/p:PublishProfile=linux-arm64",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-win-x64",
            "dependsOn": ["build-ui"],
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/NanoBot/NanoBot.csproj",
                "/p:PublishProfile=win-x64",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "dependsOn": ["build"],
            "type": "shell",
            "command": "Start-Process",
            "args": [
                "pwsh",
                "-ArgumentList", "'-NoExit', '-Command', 'dotnet run --project ''${workspaceFolder}/NanoBot/NanoBot.csproj'''",
                "-WorkingDirectory", "'${workspaceFolder}/NanoBot/bin/Debug/net8.0'"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "build-ui",
            "command": "npm",
            "type": "process",
            "args": [
                "run",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ui"
            },
            "problemMatcher": []
        }
    ]
}